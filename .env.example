# Public client configuration. Supabase publishable/anon keys are safe to use
# in the browser when Row Level Security policies are correctly configured.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Name of the authenticated Supabase Edge Function that proxies n8n.
VITE_ITINERARY_FUNCTION_NAME=generate-itinerary
VITE_ITINERARY_TIMEOUT_MS=65000
