{
  "name": "explora-sc",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "node --experimental-strip-types --test src/components/attraction-rating.test.ts src/features/auth/recovery-callback.test.ts src/features/itinerary/schema.test.ts src/features/itinerary/calendar-date.test.ts src/features/itinerary/map-utils.test.ts src/features/itinerary/navigation-urls.test.ts src/features/itinerary/user-location.test.ts src/features/itinerary/saved-schema.test.ts src/features/community/schema.test.ts src/features/partners/selection.test.ts src/features/routes/routes.test.ts src/features/credits/pending.test.ts",
    "test:edge": "npx --yes deno test --allow-env --allow-read --config supabase/functions/generate-itinerary/deno.json supabase/functions/generate-itinerary/index.test.ts",
    "preview": "vite preview",
    "video:typecheck": "tsc --project video/tsconfig.json",
    "video:assets": "node video/optimize-assets.mjs",
    "video:styles": "tailwindcss -c video/tailwind.config.ts -i src/index.css -o video/app.css --minify",
    "video:poster": "remotion still video/index.tsx ExploraHero video/hero-poster.jpg --frame=220 --image-format=jpeg --jpeg-quality=85",
    "video:mp4": "remotion render video/index.tsx ExploraHero public/landing/explorasc-hero.mp4 --codec=h264 --crf=25 --concurrency=2 --muted",
    "video:webm": "remotion render video/index.tsx ExploraHero public/landing/explorasc-hero.webm --codec=vp9 --crf=36 --concurrency=2 --muted"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@microsoft/clarity": "^1.0.2",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@supabase/supabase-js": "^2.78.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.462.0",
    "maplibre-gl": "^6.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.61.1",
    "react-router-dom": "^7.18.3",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@remotion/cli": "4.0.526",
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "postcss": "^8.5.6",
    "remotion": "4.0.526",
    "sharp": "0.35.4",
    "supabase": "^2.117.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^6.4.3"
  }
}
